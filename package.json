{
  "name": "cad-ai-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local MCP and CLI bridge for practical CAD workflows, current-document collaboration and optional Tangent V8 extensions",
  "license": "MIT",
  "bin": {
    "cadbridge": "bin/cadbridge.mjs"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:cad": "node tests/integration.mjs",
    "test:tangent": "node tests/tangent-integration.mjs",
    "mcp": "node mcp-server.mjs",
    "setup": "node bin/cadbridge.mjs setup",
    "doctor": "node bin/cadbridge.mjs doctor",
    "demo": "node bin/cadbridge.mjs demo",
    "check": "node scripts/check-release.mjs",
    "package:preview": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "pdf-lib": "1.17.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22.19"
  }
}
